# Copy this file to .env (same folder) and fill in values.
# NEVER commit the real .env file.

# Port the Express API listens on.
# (Avoid 5000 on macOS — it's used by AirPlay Receiver.)
PORT=4000

# development | production
NODE_ENV=development

# Frontend origin allowed by CORS (comma-separate multiple origins)
CLIENT_URL=http://localhost:5173

# --- Supabase (Dashboard → Project Settings → API Keys) ---
# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# Publishable key (starts with sb_publishable_). Safe to share with the browser; RLS applies.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (starts with sb_secret_). BYPASSES Row Level Security — server only, never in the client.
# Needed for test payments (Phase 10) and the admin dashboard (Phase 11).
SUPABASE_SECRET_KEY=

# --- Razorpay TEST mode (Dashboard → switch to Test Mode → Account & Settings → API Keys) ---
# Only test keys are accepted (rzp_test_…). Live keys are rejected at startup.
# Payments also need SUPABASE_SECRET_KEY above (the server writes subscriptions/payments).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
