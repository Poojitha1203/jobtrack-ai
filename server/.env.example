# Copy this file to .env (same folder) and fill in values.
# NEVER commit the real .env file.

# Port the Express API listens on.
# (Avoid 5000 on macOS — it's used by AirPlay Receiver.)
PORT=4000

# development | production
NODE_ENV=development

# Frontend origin allowed by CORS (comma-separate multiple origins)
CLIENT_URL=http://localhost:5173

# --- Added in Phase 3 (Supabase) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=   # server only — never put this in the client

# --- Added in Phase 10 (Razorpay TEST mode) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
