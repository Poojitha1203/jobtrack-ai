# Copy this file to .env (same folder).
# Only variables prefixed with VITE_ are exposed to the browser —
# so NEVER put secrets (Supabase secret key, payment secrets) here.

# Base URL of the Express API.
# Leave empty in development: Vite proxies /api to http://localhost:4000.
# Set to your deployed API URL in production (e.g. https://your-api.vercel.app).
VITE_API_URL=

# --- Supabase (Dashboard → Project Settings → API Keys) ---
# Project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=
# Publishable key (starts with sb_publishable_). Safe in the browser — Row Level Security protects data.
VITE_SUPABASE_PUBLISHABLE_KEY=
