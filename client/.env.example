# Copy this file to .env (same folder).
# Only variables prefixed with VITE_ are exposed to the browser —
# so NEVER put secrets (service-role keys, payment secrets) here.

# Base URL of the Express API.
# Leave empty in development: Vite proxies /api to http://localhost:4000.
# Set to your deployed API URL in production (e.g. https://your-api.vercel.app).
VITE_API_URL=

# --- Added in Phase 3 (Supabase) — the anon key is safe to expose; RLS protects data ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
